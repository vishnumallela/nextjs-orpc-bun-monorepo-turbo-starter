  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "bun-types": "^1.3.10",
    "husky": "^9.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0",
    "ultracite": "^7.2.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
